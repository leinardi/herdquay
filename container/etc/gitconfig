# System Git configuration for HerdQuay. The user's identity goes in ~/.gitconfig
# (HERDQUAY_GIT_NAME / HERDQUAY_GIT_EMAIL, seeded once by the entrypoint).
[init]
	defaultBranch = main
[credential "https://github.com"]
	# HTTPS remotes authenticate with the same fine-grained token gh uses.
	helper =
	helper = !/usr/local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/local/bin/gh auth git-credential
