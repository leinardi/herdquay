# HerdQuay sshd, run by the unprivileged herdquay user (no root, no PAM), so it can only ever log
# in that same user. Adapted from rozsival/devbox, MIT License, Copyright (c) 2026 Vít Rozsíval.
# sshd_config expands no `~`: every path is absolute.

Port 2222
ListenAddress 0.0.0.0
HostKey /home/herdquay/.ssh/host/ssh_host_ed25519_key
PidFile none

AuthorizedKeysFile /home/herdquay/.ssh/authorized_keys
AllowUsers herdquay
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PermitEmptyPasswords no
UsePAM no
StrictModes yes

# Manual `ssh -A` sessions may forward an agent; Herdr never does.
AllowAgentForwarding yes
AllowTcpForwarding yes
PermitTunnel no
X11Forwarding no
GatewayPorts no

# Herdr multiplexes many channels over one connection.
MaxSessions 32
ClientAliveInterval 30
ClientAliveCountMax 6

AcceptEnv LANG LC_* TERM COLORTERM
# The deployment's Docker endpoint, the daemon's hostname, the Testcontainers overrides and the
# temp dir, and only those: herdquay-entrypoint rewrites ~/.ssh/environment from its environment
# at every start, and sshd reads nothing else from it. Keep this list in step with
# SESSION_ENV_NAMES there. Never a general pass-through.
PermitUserEnvironment DOCKER_HOST,DOCKER_TLS_VERIFY,DOCKER_CERT_PATH,HERDQUAY_DOCKER_HOSTNAME,TESTCONTAINERS_HOST_OVERRIDE,TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE,TMPDIR,CLAUDE_CODE_TMPDIR
# Every session, login or not (Herdr's background commands are not), gets the image's tool paths.
SetEnv PATH=/home/herdquay/.local/bin:/home/herdquay/.opencode/bin:/home/herdquay/.cargo/bin:/home/herdquay/go/bin:/usr/local/go/bin:/opt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin GOTOOLCHAIN=auto LANG=C.UTF-8
PrintMotd no
LogLevel INFO
Subsystem sftp internal-sftp
