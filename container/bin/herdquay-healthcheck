# Container health: sshd listens on 2222 and the Herdr server answers. A failed agent restore does
# not make the container unhealthy (herdquay-agents logs it), so the restart policy cannot loop on
# it.

set -euo pipefail

ss -Hltn 'sport = :2222' | grep -q . || {
	echo "sshd is not listening on 2222" >&2
	exit 1
}
herdr status server 2>/dev/null | grep -q '^status: running' || {
	echo "the Herdr server is not running" >&2
	exit 1
}
