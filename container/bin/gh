# gh with HerdQuay's GitHub token: read from the secret file (HERDQUAY_GITHUB_TOKEN_FILE, default
# /run/secrets/github_token) into GH_TOKEN for this one process, so the token is never written to
# gh's hosts.yml or exported to every shell. An explicit GH_TOKEN or GITHUB_TOKEN wins. Git's HTTPS
# credential helper calls this wrapper too (/etc/gitconfig).

set -euo pipefail

token_file="${HERDQUAY_GITHUB_TOKEN_FILE:-/run/secrets/github_token}"
if [[ -z ${GH_TOKEN:-} && -z ${GITHUB_TOKEN:-} && -r ${token_file} ]]; then
	token="$(<"${token_file}")"
	token="${token//[[:space:]]/}"
	if [[ -n ${token} ]]; then
		export GH_TOKEN="${token}"
	fi
fi
exec /opt/gh/bin/gh "$@"
