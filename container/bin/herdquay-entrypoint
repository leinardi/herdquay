# HerdQuay's entrypoint, run under tini as the unprivileged user. Prepares the persistent home,
# then supervises two children, sshd and the headless Herdr server: when either exits on its own,
# the other is stopped and the container exits non-zero so the orchestrator restarts it. A
# requested stop (SIGTERM, SIGINT) stops both within HERDQUAY_STOP_TIMEOUT seconds and exits 0.
# Claude Code itself is installed into the home volume first (herdquay-claude-install;
# HERDQUAY_CLAUDE_INSTALL=0 skips it), and so is opencode (install_opencode); Rust follows once
# sshd and Herdr run, in the background (herdquay-rust-install; HERDQUAY_RUST_INSTALL=0 skips it).
# All three then update (rustup update for Rust), and the image's versions are only minimums. The
# Git identity and the GitHub App's configuration for SSH sessions are rewritten in
# ~/.config/herdquay at every start. Herdr's native restore resumes the
# previous run's Claude agents; once Herdr answers, herdquay-agents checks that it did, in the
# background and unsupervised (a miss is logged, never fatal). HERDQUAY_AGENT_RESTORE=1 makes
# herdquay-agents resume them itself instead, the fallback for a Herdr release whose headless
# restore stops working (turn native restore off with it).

set -euo pipefail

STOP_TIMEOUT="${HERDQUAY_STOP_TIMEOUT:-15}"
AGENT_RESTORE="${HERDQUAY_AGENT_RESTORE:-0}"
CLAUDE_INSTALL="${HERDQUAY_CLAUDE_INSTALL:-1}"
RUST_INSTALL="${HERDQUAY_RUST_INSTALL:-1}"
AUTHORIZED_KEYS_FILE="${HERDQUAY_AUTHORIZED_KEYS_FILE:-/run/secrets/authorized_keys}"
STATE_DIR="${HOME}/.local/state/herdquay"
HERDR_DIR="${HOME}/.config/herdr"
SHARE_DIR=/usr/local/share/herdquay
OPENCODE_DIR="${HOME}/.opencode/bin"
HERDQUAY_CONFIG_DIR="${HOME}/.config/herdquay"

log() {
	printf '%s herdquay: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

die() {
	log "error: $*"
	exit 1
}

# A process that has exited but is not reaped yet is a zombie: kill -0 still succeeds on it.
alive() {
	local state
	[[ -r /proc/$1/stat ]] || return 1
	read -r _ _ state _ <"/proc/$1/stat" || return 1
	[[ ${state} != Z ]]
}

prepare_home() {
	umask 077
	mkdir -p "${HOME}/.ssh/host" "${HERDR_DIR}" "${HOME}/.claude" "${HOME}/.config/opencode" "${HOME}/workspace" "${STATE_DIR}" "${HERDQUAY_CONFIG_DIR}"
	# sshd's StrictModes refuses a group- or world-writable home or ~/.ssh.
	chmod go-w "${HOME}"
	chmod 0700 "${HOME}/.ssh"
}

ensure_host_key() {
	local key="${HOME}/.ssh/host/ssh_host_ed25519_key"
	if [[ ! -s ${key} ]]; then
		rm -f "${key}" "${key}.pub"
		ssh-keygen -q -t ed25519 -N '' -C herdquay-host -f "${key}"
		log "generated the SSH host key"
	fi
	log "SSH host key: $(ssh-keygen -l -f "${key}.pub")"
}

# authorized_keys is rebuilt from the secret on every start, so removing a key from the secret
# revokes it at the next restart. Fails closed: no valid key, no start.
install_authorized_keys() {
	local tmp count
	[[ -r ${AUTHORIZED_KEYS_FILE} ]] ||
		die "no readable authorized keys file at ${AUTHORIZED_KEYS_FILE} (HERDQUAY_AUTHORIZED_KEYS_FILE)"
	tmp="$(mktemp "${HOME}/.ssh/authorized_keys.XXXXXX")"
	grep -Ev '^[[:space:]]*(#|$)' "${AUTHORIZED_KEYS_FILE}" >"${tmp}" || true
	if [[ ! -s ${tmp} ]] || ! ssh-keygen -l -f "${tmp}" >/dev/null 2>&1; then
		rm -f "${tmp}"
		die "${AUTHORIZED_KEYS_FILE} holds no valid public key"
	fi
	chmod 0600 "${tmp}"
	mv -f "${tmp}" "${HOME}/.ssh/authorized_keys"
	count="$(wc -l <"${HOME}/.ssh/authorized_keys")"
	log "authorized ${count} SSH key(s)"
}

# Seeds the configuration once; a file the user already has is never overwritten, except that
# Claude's settings gain remoteControlAtStartup when the key is absent.
seed_config() {
	local settings="${HOME}/.claude/settings.json" tmp
	if [[ ! -e ${HERDR_DIR}/config.toml ]]; then
		install -m 0600 "${SHARE_DIR}/herdr-config.toml" "${HERDR_DIR}/config.toml"
		log "seeded ${HERDR_DIR}/config.toml"
	fi
	[[ -s ${settings} ]] || echo '{}' >"${settings}"
	if ! jq -e 'has("remoteControlAtStartup")' "${settings}" >/dev/null; then
		tmp="$(mktemp "${settings}.XXXXXX")"
		jq '.remoteControlAtStartup = true' "${settings}" >"${tmp}"
		mv -f "${tmp}" "${settings}"
		log "enabled Remote Control for every Claude session (${settings})"
	fi
}

# The GitHub configuration for SSH sessions, which do not inherit this environment: the App ID, the
# App key's and the signing key's file paths and the API URL that are set, never a key itself.
# Rewritten at every start, so a variable removed from the deployment is gone from SSH sessions too.
# The version a binary's --version prints (`opencode v2.1.4`), empty if it does not run.
binary_version() {
	local out
	out="$(timeout 10 "$1" --version 2>/dev/null)" || return 0
	out="${out##* }"
	out="${out#v}"
	[[ ${out} =~ ^[0-9]+(\.[0-9]+)*$ ]] && printf '%s\n' "${out}"
	return 0
}

# opencode lives in ~/.opencode/bin, where its own installer puts it, so `opencode upgrade` and its
# auto-update replace it in place. The image's copy (verified at build) is the minimum: it is
# copied there only when the home has none, or an older or broken one.
install_opencode() {
	local seed="${SHARE_DIR}/opencode" seed_version current_version tmp
	seed_version="$(binary_version "${seed}")"
	if [[ -z ${seed_version} ]]; then
		log "warning: the image's opencode does not run; ${OPENCODE_DIR}/opencode left as it is"
		return 0
	fi
	current_version="$(binary_version "${OPENCODE_DIR}/opencode")"
	if [[ -n ${current_version} &&
		$(printf '%s\n' "${current_version}" "${seed_version}" | sort -V | head -n 1) == "${seed_version}" ]]; then
		return 0
	fi
	mkdir -p "${OPENCODE_DIR}"
	tmp="$(mktemp "${OPENCODE_DIR}/.opencode.XXXXXX")"
	cat "${seed}" >"${tmp}"
	chmod 0755 "${tmp}"
	mv -f "${tmp}" "${OPENCODE_DIR}/opencode"
	log "installed opencode ${seed_version}${current_version:+ (replacing ${current_version})}"
}

write_github_env() {
	local file="${HERDQUAY_CONFIG_DIR}/github.env" tmp name
	tmp="$(mktemp "${file}.XXXXXX")"
	for name in HERDQUAY_GITHUB_APP_ID HERDQUAY_GITHUB_APP_KEY_FILE HERDQUAY_GITHUB_API_URL \
		HERDQUAY_GIT_SIGNING_KEY_FILE; do
		[[ -n ${!name:-} ]] || continue
		if [[ ${!name} == *$'\n'* ]]; then
			log "warning: ${name} contains a newline: ignored"
			continue
		fi
		printf '%s=%s\n' "${name}" "${!name}" >>"${tmp}"
	done
	mv -f "${tmp}" "${file}"
}

# The commit identity, rewritten at every start into identity.gitconfig, which /etc/gitconfig
# includes at the system level (so a user.* in ~/.gitconfig still wins): HERDQUAY_GIT_NAME and
# HERDQUAY_GIT_EMAIL when both are set, otherwise the GitHub App's bot. When the bot's identity
# cannot be read (GitHub unreachable), the previous bot identity is kept.
#
# Commits and tags are signed only with the custom identity and a signing key: GitHub shows a
# signature as Verified only when the key is registered on the account the commit's email belongs
# to, and the bot cannot register one. A key mounted with the bot identity is ignored.
write_git_identity() {
	local file="${HERDQUAY_CONFIG_DIR}/identity.gitconfig" tmp name="" email="" source identity status=0
	local signing_key="${HERDQUAY_GIT_SIGNING_KEY_FILE:-/run/secrets/git_signing_key}" fingerprint=""
	if [[ -n ${HERDQUAY_GIT_NAME:-} && -n ${HERDQUAY_GIT_EMAIL:-} ]]; then
		name="${HERDQUAY_GIT_NAME}"
		email="${HERDQUAY_GIT_EMAIL}"
		source="HERDQUAY_GIT_NAME and HERDQUAY_GIT_EMAIL"
	else
		if [[ -n ${HERDQUAY_GIT_NAME:-} || -n ${HERDQUAY_GIT_EMAIL:-} ]]; then
			log "warning: set both HERDQUAY_GIT_NAME and HERDQUAY_GIT_EMAIL, or neither: using the GitHub App's bot"
		fi
		identity="$(timeout 10 herdquay-github identity)" || status=$?
		if ((status == 3)); then
			rm -f "${file}"
			log "no Git identity configured (no HERDQUAY_GIT_NAME and HERDQUAY_GIT_EMAIL, no GitHub App)"
			return 0
		fi
		if ((status != 0)); then
			keep_bot_identity "${file}" "could not read the GitHub App bot's identity (status ${status})"
			return 0
		fi
		name="$(sed -n 's/^name=//p' <<<"${identity}")"
		email="$(sed -n 's/^email=//p' <<<"${identity}")"
		if [[ -z ${name} || -z ${email} ]]; then
			keep_bot_identity "${file}" "the GitHub App bot's identity is incomplete"
			return 0
		fi
		source="the GitHub App's bot"
		if [[ -s ${signing_key} ]]; then
			log "warning: ${signing_key} is ignored: commits by the GitHub App's bot are never signed (set HERDQUAY_GIT_NAME and HERDQUAY_GIT_EMAIL to sign)"
		fi
	fi
	tmp="$(mktemp "${file}.XXXXXX")"
	printf '# Written by herdquay-entrypoint at every start; edits are lost.\n# source: %s\n' "${source}" >"${tmp}"
	git config --file "${tmp}" user.name "${name}"
	git config --file "${tmp}" user.email "${email}"
	if [[ ${source} != "the GitHub App's bot" && -s ${signing_key} ]]; then
		fingerprint="$(herdquay-gpg --batch --with-colons --list-secret-keys 2>/dev/null |
			awk -F: '$1 == "fpr" { print $10; exit }')" || true
		if [[ -n ${fingerprint} ]]; then
			git config --file "${tmp}" gpg.program /usr/local/bin/herdquay-gpg
			git config --file "${tmp}" user.signingkey "${fingerprint}"
			git config --file "${tmp}" commit.gpgsign true
			git config --file "${tmp}" tag.gpgsign true
		else
			log "warning: could not import the signing key ${signing_key}: commits are not signed"
		fi
	fi
	mv -f "${tmp}" "${file}"
	log "Git identity: ${name} <${email}> (${source})${fingerprint:+, signing with ${fingerprint}}"
}

# keep_bot_identity <file> <reason>: keeps a previous bot identity, but drops a custom one, which
# the environment no longer asks for (and which may carry the signing configuration).
keep_bot_identity() {
	if [[ -r $1 ]] && grep -qx "# source: the GitHub App's bot" "$1"; then
		log "warning: $2: keeping the previous Git identity"
	else
		rm -f "$1"
		log "warning: $2: no Git identity"
	fi
}

wait_for_herdr() {
	local i
	for ((i = 0; i < 60; i++)); do
		if herdr status server 2>/dev/null | grep -q '^status: running'; then
			return 0
		fi
		alive "${herdr_pid}" || return 1
		sleep 0.5
	done
	return 1
}

stop_children() {
	local deadline=$((SECONDS + STOP_TIMEOUT)) pid
	log "stopping sshd and the Herdr server"
	kill -TERM "${herdr_pid}" "${sshd_pid}" 2>/dev/null || true
	while ((SECONDS < deadline)); do
		alive "${herdr_pid}" || alive "${sshd_pid}" || break
		sleep 0.2
	done
	for pid in "${herdr_pid}" "${sshd_pid}"; do
		if alive "${pid}"; then
			log "process ${pid} ignored SIGTERM for ${STOP_TIMEOUT}s: killing it"
			kill -KILL "${pid}" 2>/dev/null || true
		fi
	done
	wait "${herdr_pid}" "${sshd_pid}" 2>/dev/null || true
}

main() {
	local stop_requested=0 failed=0 status agent

	[[ $(id -u) -ne 0 ]] || die "refusing to run as root"
	[[ ${STOP_TIMEOUT} =~ ^[0-9]+$ ]] || die "HERDQUAY_STOP_TIMEOUT must be a whole number of seconds"

	prepare_home
	ensure_host_key
	install_authorized_keys
	seed_config
	install_opencode
	write_github_env
	write_git_identity
	# Before the Herdr server starts: its native restore resumes the Claude panes right away. A
	# failed install is not fatal (the next start retries, herdquay doctor reports it), so a
	# network outage does not lock the owner out of SSH.
	if [[ ${CLAUDE_INSTALL} == 1 ]]; then
		herdquay-claude-install || log "warning: Claude Code is not installed; the next start retries"
	fi

	# The layout of the previous run, read by herdquay-agents before the new server rewrites it.
	if [[ -s ${HERDR_DIR}/session.json ]]; then
		cp -f "${HERDR_DIR}/session.json" "${STATE_DIR}/previous-session.json"
	else
		rm -f "${STATE_DIR}/previous-session.json"
	fi

	trap 'stop_requested=1' TERM INT
	# Caught, not ignored: an ignored signal stays ignored in every child, SSH session shells included.
	trap ':' HUP

	/usr/sbin/sshd -D -e -f /etc/ssh/sshd_config &
	sshd_pid=$!
	# A session leader of its own: Herdr only accepts a server that is one ("detached daemon") as a
	# saved machine for desktop clients. setsid does not fork here (a background job is not a
	# process group leader), so the pid stays the one supervised below.
	(cd "${HOME}" && exec setsid herdr server) &
	herdr_pid=$!
	log "started sshd (pid ${sshd_pid}) and the Herdr server (pid ${herdr_pid})"
	# After sshd and Herdr, in the background and unsupervised: a first download can take longer
	# than the healthcheck's start period, and nothing at start needs Rust.
	if [[ ${RUST_INSTALL} == 1 ]]; then
		(herdquay-rust-install || log "warning: Rust is not installed at the image's minimum; the next start retries") &
	fi

	if wait_for_herdr; then
		for agent in claude opencode; do
			herdr integration install "${agent}" >/dev/null 2>&1 ||
				log "warning: could not install the Herdr ${agent} integration"
		done
		if [[ ${AGENT_RESTORE} == 1 ]]; then
			if grep -Eq '^[[:space:]]*resume_agents_on_restore[[:space:]]*=[[:space:]]*true' "${HERDR_DIR}/config.toml"; then
				log "warning: HERDQUAY_AGENT_RESTORE=1 with Herdr's native restore on: the two can race; set resume_agents_on_restore = false"
			fi
			herdquay-agents restore "${STATE_DIR}/previous-session.json" &
		else
			herdquay-agents verify "${STATE_DIR}/previous-session.json" &
		fi
	else
		log "error: the Herdr server did not come up"
	fi

	while :; do
		status=0
		wait -n "${sshd_pid}" "${herdr_pid}" || status=$?
		if ((stop_requested)); then
			break
		fi
		if ! alive "${sshd_pid}"; then
			log "error: sshd exited (status ${status})"
			failed=1
			break
		fi
		if ! alive "${herdr_pid}"; then
			log "error: the Herdr server exited (status ${status})"
			failed=1
			break
		fi
	done

	stop_children
	if ((failed)); then
		exit 1
	fi
	log "stopped"
	exit 0
}

main "$@"
