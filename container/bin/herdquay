# HerdQuay's operator CLI.
#
# Usage: herdquay doctor [--network]
#
# doctor checks the running environment and prints one line per check: ok, warn or FAIL. It exits 1
# when any check fails. --network adds the checks that reach GitHub (a GitHub App installation
# token, gh and Git over HTTPS), which need the App's key and outbound access.

set -euo pipefail

failures=0
warnings=0

ok() { printf '  ok    %s\n' "$*"; }
warn() {
	printf '  warn  %s\n' "$*"
	warnings=$((warnings + 1))
}
fail() {
	printf '  FAIL  %s\n' "$*"
	failures=$((failures + 1))
}

section() { printf '\n%s\n' "$*"; }

check_tool() {
	local name="$1" version
	shift
	if ! command -v "${name}" >/dev/null; then
		fail "${name}: not on PATH"
		return
	fi
	version="$("$@" 2>&1 | head -n 1)" || {
		fail "${name}: '$*' failed"
		return
	}
	ok "${name}: ${version}"
}

check_secret() {
	local label="$1" file="$2" required="$3"
	if [[ -r ${file} && -s ${file} ]]; then
		ok "${label}: ${file} readable"
	elif [[ ${required} == required ]]; then
		fail "${label}: ${file} missing or unreadable"
	else
		warn "${label}: ${file} missing or unreadable (optional)"
	fi
}

# The GitHub App's configuration as herdquay-github reads it: the environment, else the github.env
# the entrypoint writes for SSH sessions.
github_config() {
	local key value
	if [[ -r ${HOME}/.config/herdquay/github.env ]]; then
		while IFS='=' read -r key value; do
			case "${key}" in
			HERDQUAY_GITHUB_APP_ID | HERDQUAY_GITHUB_APP_KEY_FILE)
				[[ -n ${!key:-} ]] || printf -v "${key}" '%s' "${value}"
				;;
			esac
		done <"${HOME}/.config/herdquay/github.env"
	fi
	app_id="${HERDQUAY_GITHUB_APP_ID:-}"
	app_key="${HERDQUAY_GITHUB_APP_KEY_FILE:-/run/secrets/github_app_key}"
}

# The effective commit identity and where it comes from. A user.* in ~/.gitconfig overrides the
# identity the entrypoint writes; an older HerdQuay seeded one there, which nothing removes.
check_git_identity() {
	local file="${HOME}/.config/herdquay/identity.gitconfig" name email configured_name="" configured_email=""
	local source="" user_name="" user_email=""
	name="$(git config user.name || true)"
	email="$(git config user.email || true)"
	if [[ -r ${file} ]]; then
		configured_name="$(git config --file "${file}" user.name || true)"
		configured_email="$(git config --file "${file}" user.email || true)"
		source="$(sed -n 's/^# source: //p' "${file}")"
	fi
	if [[ -r ${HOME}/.gitconfig ]]; then
		user_name="$(git config --file "${HOME}/.gitconfig" user.name || true)"
		user_email="$(git config --file "${HOME}/.gitconfig" user.email || true)"
	fi
	if [[ -n ${user_name} || -n ${user_email} ]]; then
		if [[ -n ${configured_name} ]] &&
			[[ (-n ${user_name} && ${user_name} != "${configured_name}") || (-n ${user_email} && ${user_email} != "${configured_email}") ]]; then
			warn "${HOME}/.gitconfig sets user.name/user.email (${user_name:-unset} <${user_email:-unset}>), overriding the configured ${configured_name} <${configured_email}> (${source}); if an older HerdQuay seeded them, remove them: git config --global --unset user.name && git config --global --unset user.email"
		fi
		source="${HOME}/.gitconfig"
	fi
	if [[ -z ${name} || -z ${email} ]]; then
		warn "no Git commit identity: set HERDQUAY_GIT_NAME and HERDQUAY_GIT_EMAIL, or configure the GitHub App"
	else
		ok "commit identity: ${name} <${email}> (${source:-unknown source})"
	fi
}

check_github() {
	local token status=0 repo out
	token="$(herdquay-github token 2>&1)" || status=$?
	if ((status != 0)); then
		fail "GitHub App installation token: ${token}"
		return
	fi
	ok "GitHub App: installation token minted"
	if ! repo="$(gh api 'installation/repositories?per_page=1' --jq '.repositories[0].full_name // empty' 2>&1)"; then
		fail "gh api installation/repositories: ${repo}"
		return
	fi
	if [[ -z ${repo} ]]; then
		warn "the GitHub App installation has no repository"
		return
	fi
	ok "gh: the installation lists ${repo}"
	if out="$(GIT_TERMINAL_PROMPT=0 timeout 30 git ls-remote "https://github.com/${repo}.git" HEAD 2>&1)"; then
		ok "git over HTTPS: ls-remote ${repo}"
	else
		fail "git ls-remote https://github.com/${repo}.git: ${out}"
	fi
}

doctor() {
	local network=0 status integrations pinned app_id app_key
	[[ ${1:-} == --network ]] && network=1

	section "Identity"
	if [[ $(id -u) -eq 0 ]]; then
		fail "running as root"
	else
		ok "running as $(id -un) ($(id -u):$(id -g))"
	fi
	if pgrep -u 0 >/dev/null 2>&1; then
		fail "a process runs as root: $(pgrep -u 0 -l | head -n 3 | tr '\n' ' ')"
	else
		ok "no process runs as root"
	fi

	section "Services"
	if ss -Hltn 'sport = :2222' | grep -q .; then ok "sshd listens on 2222"; else fail "sshd is not listening on 2222"; fi
	if herdr status server 2>/dev/null | grep -q '^status: running'; then
		ok "Herdr server running"
	else
		fail "Herdr server not running"
	fi
	integrations="$(herdr integration status 2>/dev/null || true)"
	if grep -q '^claude: current' <<<"${integrations}"; then
		ok "Herdr Claude integration current"
	else
		warn "Herdr Claude integration not current (herdr integration install claude)"
	fi
	if grep -q '^opencode: current' <<<"${integrations}"; then
		ok "Herdr opencode integration current"
	else
		warn "Herdr opencode integration not current (herdr integration install opencode)"
	fi
	if jq -e '.remoteControlAtStartup == true' "${HOME}/.claude/settings.json" >/dev/null 2>&1; then
		ok "Remote Control enabled for every Claude session"
	else
		warn "remoteControlAtStartup is not true in ~/.claude/settings.json"
	fi
	status="${HOME}/.local/state/herdquay/agents-status.json"
	if [[ ! -s ${status} ]]; then
		warn "no agent restore check yet (${status})"
	elif jq -e '.missing == []' "${status}" >/dev/null; then
		ok "every recorded Claude session resumed ($(jq -r .checked "${status}"))"
	else
		warn "not resumed: $(jq -r '[.missing[] | .cwd] | join(", ")' "${status}")"
	fi

	section "Secrets"
	check_secret "authorized keys" "${HERDQUAY_AUTHORIZED_KEYS_FILE:-/run/secrets/authorized_keys}" required
	github_config
	check_secret "GitHub App key" "${app_key}" optional
	if [[ -n ${app_id} && ! -s ${app_key} ]]; then
		warn "HERDQUAY_GITHUB_APP_ID is set (${app_id}) but the GitHub App key ${app_key} is missing"
	elif [[ -z ${app_id} && -e ${app_key} ]]; then
		warn "the GitHub App key ${app_key} is present but HERDQUAY_GITHUB_APP_ID is not set"
	elif [[ -n ${app_id} ]]; then
		ok "GitHub App ID: ${app_id}"
	fi
	if [[ -n ${DOCKER_HOST:-} ]]; then
		warn "DOCKER_HOST is set (${DOCKER_HOST}): Docker diagnostics are an opt-in deployment decision"
	else
		ok "no Docker API configured (DOCKER_HOST unset)"
	fi
	if [[ -e /var/run/docker.sock ]]; then
		fail "/var/run/docker.sock is mounted: HerdQuay must never get the Docker socket"
	fi

	section "Git"
	check_git_identity

	section "Tools"
	check_tool git git --version
	check_tool gh gh --version
	check_tool ssh ssh -V
	check_tool herdr herdr --version
	check_tool claude claude --version
	pinned="$(sed -n 's/^HERDQUAY_CLAUDE_VERSION=//p' /usr/local/share/herdquay/claude-release)"
	if [[ -n ${pinned} && $(readlink -f "${HOME}/.local/bin/claude" 2>/dev/null) == "${HOME}/.local/share/claude/versions/${pinned}" ]]; then
		ok "Claude Code is the pinned ${pinned}"
	else
		fail "Claude Code is not the pinned ${pinned:-version} (restart, or run herdquay-claude-install)"
	fi
	check_tool opencode opencode --version
	check_tool go go version
	check_tool node node --version
	check_tool npm npm --version
	check_tool python3 python3 --version
	check_tool pre-commit pre-commit --version
	check_tool make make --version
	check_tool gcc gcc --version
	check_tool golangci-lint golangci-lint version
	check_tool goreleaser bash -c 'goreleaser --version | sed -n "s/^GitVersion: */goreleaser /p"'
	check_tool hadolint hadolint --version
	check_tool docker docker --version
	check_tool jq jq --version
	check_tool yq yq --version
	check_tool rg rg --version

	if ((network)); then
		section "GitHub"
		check_github
	fi

	printf '\n%d failure(s), %d warning(s)\n' "${failures}" "${warnings}"
	((failures == 0))
}

case "${1:-}" in
doctor)
	shift
	doctor "$@"
	;;
*)
	echo "Usage: herdquay doctor [--network]" >&2
	exit 2
	;;
esac
